{
  "version": 2,
  "name": "zaqzouka-tv",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/:file.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Cache-Control", "value": "public, s-maxage=86400, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/:path*.(js|css|png|jpg|jpeg|ico|svg|woff2|woff|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=604800, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
