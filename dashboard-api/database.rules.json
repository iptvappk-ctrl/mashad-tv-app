{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      ".indexOn": ["deviceId", "status", "lastSeen", "openedAt"],
      ".read": false,
      ".write": false
    },
    "stats": {
      ".indexOn": ["firstOpens", "webVisits"]
    },
    "activityLog": {
      ".indexOn": ["timestamp"]
    }
  }
}
