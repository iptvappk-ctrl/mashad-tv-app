# GA4 property ID from Firebase Project settings > Integrations > Google Analytics.
GA_PROPERTY_ID=

# Path to a service-account JSON stored outside the repository.
# You may use Google Application Default Credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_USER/.config/madartv/analytics-reader.json

# The dashboard is intentionally local-only by default.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4040
